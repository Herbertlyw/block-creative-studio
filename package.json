{
  "name": "block-creative-studio",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "A browser studio for editable BB placement and BC falling-block videos, reference direction, and creative variants.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.calibrated.json --noEmit --pretty false",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser-workbench.mjs",
    "test:bc": "vitest run tests/blockCrushShowcase.test.ts",
    "test:browser:bc": "node scripts/verify-bc-workbench.mjs",
    "test:browser:bc:edits": "node scripts/verify-bc-edit-drafts.mjs",
    "test:browser:bc:usability": "node scripts/verify-bc-usability.mjs",
    "test:browser:bc:lifecycle": "node scripts/verify-bc-player-lifecycle.mjs",
    "test:browser:observation": "node scripts/verify-blank-observation.mjs",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check:core": "vitest run tests/currentCore.test.ts",
    "check:bb-single-mainline": "node scripts/check-bb-single-mainline.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:json": "node scripts/check-json.mjs",
    "check:syntax": "tsc -p tsconfig.app.json --noEmit --noCheck --pretty false && tsc -p tsconfig.node.json --noEmit --noCheck --pretty false",
    "check": "npm run check:source && npm run check:core",
    "check:bb-demo": "node scripts/check-bb-single-mainline.mjs --demo",
    "test:demo": "vitest run tests/bbDemoWorkflow.test.ts tests/bbWorkPackage.test.ts tests/nativeWorkAuthor.test.ts tests/bindObservedCalibration.test.ts tests/workbenchCalibration.test.ts tests/browserAssetReferences.test.ts",
    "test:browser:demo": "node scripts/verify-demo-workflow.mjs",
    "test:browser:preview-session": "node scripts/verify-preview-session.mjs",
    "test:browser:landing-draft": "node scripts/verify-landing-observation-draft.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:repository": "node scripts/check-repository-cleanliness.mjs",
    "test:repository": "node --test scripts/repository-cleanliness.test.mjs",
    "build:cli": "vite build --ssr src/cli/bcs.ts --outDir dist-cli",
    "bcs": "node dist-cli/bcs.js",
    "test:cli": "node scripts/verify-cli-foundation.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "mediabunny": "1.54.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "jpeg-js": "0.4.4",
    "playwright-core": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@10.9.2",
  "bin": {
    "bcs": "dist-cli/bcs.js"
  }
}
