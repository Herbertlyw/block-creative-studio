{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://block-creative.local/schema/project-v1.json",
  "title": "Block Creative Studio project bundle",
  "type": "object",
  "required": ["format", "version", "project", "takes"],
  "properties": {
    "format": {
      "const": "block-creative-studio-project"
    },
    "version": {
      "const": "1.0.0"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "takes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/take"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tileColor": {
      "enum": ["coral", "amber", "lime", "cyan", "blue", "violet", "rose"]
    },
    "cell": {
      "type": "object",
      "required": ["row", "col"],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "required": ["rows", "cols", "cells"],
      "properties": {
        "rows": {
          "const": 8
        },
        "cols": {
          "const": 8
        },
        "cells": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/tileColor"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "piece": {
      "type": "object",
      "required": ["id", "shapeId", "color", "used", "setIndex", "slotIndex"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "shapeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "color": {
          "$ref": "#/$defs/tileColor"
        },
        "used": {
          "type": "boolean"
        },
        "setIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "slotIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "cellColors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/tileColor"
          },
          "description": "Optional colors matching PieceShape.cells order; runtime validates the exact length for shapeId."
        }
      },
      "additionalProperties": false
    },
    "pieceTray": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/piece"
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["board", "pieces", "seed", "setIndex", "turn", "score", "combo", "status"],
      "properties": {
        "board": {
          "$ref": "#/$defs/board"
        },
        "pieces": {
          "$ref": "#/$defs/pieceTray"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "setIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "combo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "status": {
          "enum": ["playing", "game-over"]
        },
        "clearAxes": {
          "enum": ["both", "columns", "rows"]
        },
        "clearTrigger": {
          "enum": ["board-full", "line-complete"]
        },
        "referenceClearRules": {
          "$ref": "#/$defs/referenceClearRules"
        },
        "seedSupplyVersion": { "const": "reference-worktree-0f237a8f" },
        "fixedPieceSupply": {
          "$ref": "#/$defs/fixedPieceSupply"
        },
        "supplyExhausted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "referenceClearRules": {
      "type": "array",
      "minItems": 0,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["turn"],
        "additionalProperties": false,
        "anyOf": [{ "required": ["axes"] }, { "required": ["trigger"] }],
        "properties": {
          "turn": { "type": "integer", "minimum": 0, "maximum": 499 },
          "axes": { "enum": ["rows", "columns", "both"] },
          "trigger": { "enum": ["line-complete", "board-full"] }
        }
      }
    },
    "fixedPieceSupply": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/pieceTray" }
    },
    "pointerSample": {
      "type": "object",
      "required": ["frameOffset", "x", "y"],
      "properties": {
        "frameOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["id", "actor", "pieceId", "anchor", "durationFrames", "pointerPath"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "actor": {
          "enum": ["human", "agent"]
        },
        "pieceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "anchor": {
          "$ref": "#/$defs/cell"
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "pointerPathMode": { "const": "authored" },
        "pointerPath": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/pointerSample"
          }
        }
      },
      "additionalProperties": false
    },
    "take": {
      "type": "object",
      "required": ["id", "name", "createdAt", "initial", "actions"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 80
        },
        "initial": {
          "$ref": "#/$defs/snapshot"
        },
        "actions": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": ["id", "depth", "bevel", "gap"],
      "properties": {
        "id": {
          "enum": ["soft-cube", "premium-beveled", "candy-rounded"]
        },
        "depth": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2
        },
        "bevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "required": ["material", "lighting", "camera", "fx", "geometry", "background", "showPointer"],
      "properties": {
        "renderer": {
          "enum": ["reference-2d", "three-3d"]
        },
        "reference2d": {
          "$ref": "#/$defs/reference2dStyle"
        },
        "material": {
          "enum": ["glossy-plastic", "candy-resin", "crystal-glass"]
        },
        "lighting": {
          "enum": ["clean-studio", "soft-candy", "neon-contrast"]
        },
        "camera": {
          "enum": ["flat-gameplay", "premium-perspective", "dynamic-clear"]
        },
        "fx": {
          "enum": ["clean-pop", "crystal-shatter", "energy-burst"]
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "showPointer": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rhythm": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description",
        "globalSpeed",
        "dragFrames",
        "pickupDelayFrames",
        "placementSettleFrames",
        "betweenActionFrames",
        "clearDelayFrames",
        "clearDurationFrames",
        "cameraRecoveryFrames",
        "easing"
      ],
      "properties": {
        "id": {
          "enum": ["human-natural", "tight-fast", "suspense-burst", "combo-rush"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "globalSpeed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "dragFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "pickupDelayFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "placementSettleFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "betweenActionFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "clearDelayFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "clearDurationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cameraRecoveryFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "easing": {
          "enum": ["easeOutCubic", "easeInOutCubic", "easeOutBack"]
        }
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "required": ["width", "height", "fps", "quality"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096,
          "multipleOf": 2
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "quality": {
          "enum": ["preview", "standard", "cinematic"]
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "name",
        "ruleProfile",
        "seed",
        "setupBoard",
        "setupPieces",
        "style",
        "rhythm",
        "render"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "ruleProfile": {
          "const": "block-placement-classic-v1"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "setupBoard": {
          "$ref": "#/$defs/board"
        },
        "setupPieces": {
          "$ref": "#/$defs/pieceTray"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "rhythm": {
          "$ref": "#/$defs/rhythm"
        },
        "render": {
          "$ref": "#/$defs/render"
        },
        "audio": {
          "$ref": "#/$defs/studioTestAudio"
        },
        "clearAxes": {
          "enum": ["both", "columns", "rows"]
        },
        "clearTrigger": {
          "enum": ["board-full", "line-complete"]
        },
        "referenceClearRules": {
          "$ref": "#/$defs/referenceClearRules"
        },
        "seedSupplyVersion": { "const": "reference-worktree-0f237a8f" },
        "fixedPieceSupply": {
          "$ref": "#/$defs/fixedPieceSupply"
        }
      },
      "additionalProperties": false
    },
    "studioTestAudio": {
      "type": "object",
      "required": ["enabled", "sfxGain"],
      "properties": {
        "enabled": { "type": "boolean" },
        "sfxGain": { "type": "number", "minimum": 0, "maximum": 1 },
        "bgmGain": { "type": "number", "minimum": 0, "maximum": 1 },
        "bgmStartSeconds": { "type": "number", "minimum": 0 },
        "bgmSourceOffsetSeconds": { "type": "number", "minimum": 0 },
        "bgmLoop": { "type": "boolean" },
        "bgmPattern": { "const": "melody-v1" },
        "cueOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "gain", "offsetSeconds"],
            "properties": {
              "kind": { "enum": ["place", "line-cleared", "cross-cleared", "praise", "game-over"] },
              "eventId": { "type": "string", "minLength": 1, "maxLength": 512 },
              "gain": { "type": "number", "minimum": 0, "maximum": 1 },
              "offsetSeconds": { "type": "number", "minimum": -60, "maximum": 60 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "reference2dStyle": {
      "type": "object",
      "required": [
        "profile",
        "tileMaterial",
        "tileFaceSet",
        "previewFx",
        "clearFx",
        "feedbackFx",
        "ambientFx",
        "bestScore"
      ],
      "properties": {
        "backgroundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "profile": {
          "const": "block-garden-reference-v1"
        },
        "tileMaterial": {
          "enum": ["soft-bevel", "flat-matte"]
        },
        "tileFaceSet": {
          "enum": ["botanical-reference", "none"]
        },
        "previewFx": {
          "enum": ["full-line-tint", "cells-only"]
        },
        "clearFx": {
          "enum": ["sweep-score-spark", "sweep-only"]
        },
        "feedbackFx": {
          "enum": ["praise-combo", "score-only"]
        },
        "ambientFx": {
          "enum": ["garden-petals", "none"]
        },
        "bestScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    }
  }
}
