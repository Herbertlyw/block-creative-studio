{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bcs.workbench.pointer-overlay@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "projectSha256", "takeId", "fps", "style", "tracks"],
  "properties": {
    "contract": { "const": "bcs.workbench.pointer-overlay" },
    "version": { "const": "1.0.0" },
    "projectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "takeId": { "type": "string", "minLength": 1 },
    "fps": { "type": "integer", "minimum": 1 },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "radius", "anchor"],
      "properties": {
        "kind": { "const": "ring" },
        "radius": { "type": "number", "minimum": 4, "maximum": 100 },
        "anchor": { "const": "center" }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionId", "points"],
        "properties": {
          "actionId": { "type": "string", "minLength": 1 },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["time", "x", "y"],
              "properties": {
                "time": { "type": "number", "minimum": 0 },
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
