{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bcs.workbench.observation-link@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "projectSha256",
    "measurementSha256",
    "observationSha256",
    "source"
  ],
  "properties": {
    "contract": { "const": "bcs.workbench.observation-link" },
    "version": { "const": "1.0.0" },
    "projectSha256": { "$ref": "#/$defs/hash" },
    "measurementSha256": { "$ref": "#/$defs/hash" },
    "observationSha256": { "$ref": "#/$defs/hash" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "width", "height", "fps", "timeBase", "firstTimestamp", "frameCount"],
      "properties": {
        "sha256": { "$ref": "#/$defs/hash" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "string", "pattern": "^[0-9]+(/[0-9]+)?$" },
        "timeBase": { "type": "string", "pattern": "^[0-9]+(/[0-9]+)?$" },
        "firstTimestamp": { "type": "integer" },
        "frameCount": { "type": "integer", "minimum": 2 }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
