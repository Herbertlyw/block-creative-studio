{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bcs.local-library@1.0.0",
  "title": "Local shared asset library work and inventory",
  "oneOf": [
    {
      "$ref": "#/$defs/work"
    },
    {
      "$ref": "#/$defs/inventory"
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["sha256", "bytes", "names"],
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "bcs.local-library-work"
        },
        "version": {
          "const": "1.0.0"
        },
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/file"
        },
        "project": {
          "$ref": "#/$defs/file"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "resolvedProjectSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "manifest": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "files": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/file"
                }
              }
            },
            "required": ["manifest", "sha256", "files"],
            "additionalProperties": false
          }
        },
        "video": {
          "$ref": "#/$defs/file"
        },
        "acceptance": {
          "type": "object",
          "properties": {
            "project": {
              "const": "roundtrip-verified"
            },
            "video": {
              "enum": ["associated-file-only", "not-supplied"]
            },
            "humanApproval": {
              "const": "not-inferred"
            }
          },
          "required": ["project", "video", "humanApproval"],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "version",
        "gameId",
        "name",
        "source",
        "project",
        "assets",
        "resolvedProjectSha256",
        "extensions",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "bcs.local-library-assets"
        },
        "version": {
          "const": "1.0.0"
        },
        "project": {
          "$ref": "#/$defs/file"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      },
      "required": ["contract", "version", "project", "assets"],
      "additionalProperties": false
    }
  }
}
