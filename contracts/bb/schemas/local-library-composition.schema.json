{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bcs.local-library-composition@1.0.0",
  "title": "Complete local composition with shared immutable dependencies",
  "type": "object",
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["sha256", "bytes", "objectId", "mediaType"],
      "additionalProperties": false
    }
  },
  "properties": {
    "contract": {
      "const": "bcs.local-library-composition"
    },
    "version": {
      "const": "1.0.0"
    },
    "source": {
      "$ref": "#/$defs/file"
    },
    "entry": {
      "$ref": "#/$defs/file"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "producerBuild": {
      "type": "string",
      "pattern": "^bcs-cli-sha256:[a-f0-9]{64}$"
    },
    "video": {
      "$ref": "#/$defs/file"
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "dependencies": {
          "const": "verified"
        },
        "video": {
          "enum": ["associated-file-only", "not-supplied"]
        },
        "humanApproval": {
          "const": "not-inferred"
        }
      },
      "required": ["dependencies", "video", "humanApproval"],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "version",
    "source",
    "entry",
    "documents",
    "assets",
    "producerBuild",
    "acceptance"
  ],
  "additionalProperties": false
}
