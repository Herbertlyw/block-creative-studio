        },
        "amber": {
          "type": "string",
          "pattern": "^(asset:[A-Za-z0-9_-]+|data:image/png;base64,)"
        },
        "rose": {
          "type": "string",
          "pattern": "^(asset:[A-Za-z0-9_-]+|data:image/png;base64,)"
        },
        "lime": {
          "type": "string",
          "pattern": "^(asset:[A-Za-z0-9_-]+|data:image/png;base64,)"
        },
        "cyan": {
          "type": "string",
          "pattern": "^(asset:[A-Za-z0-9_-]+|data:image/png;base64,)"
        },
        "blue": {
          "type": "string",
          "pattern": "^(asset:[A-Za-z0-9_-]+|data:image/png;base64,)"
        },
        "violet": {
          "type": "string",
          "pattern": "^(asset:[A-Za-z0-9_-]+|data:image/png;base64,)"
        }
      },
      "required": ["coral", "amber", "rose", "lime", "cyan", "blue", "violet"],
