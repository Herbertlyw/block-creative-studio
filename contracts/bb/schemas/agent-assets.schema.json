{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://block-creative.local/schema/agent-assets-v1.json",
  "title": "Inline and referenced image/sequence assets and bindings",
  "$comment": "Generated by npm run schemas:generate from persisted TS types and live game contracts. Do not edit this file directly.",
  "description": "Structural validation only. Run the owning game validation, replay and asset resolver for cross-field identity, geometry, hashes, resource budgets and rendering readiness.",
  "type": "object",
  "properties": {
    "version": {
      "enum": ["1.0.0", 1]
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/AgentImageAsset"
          },
          {
            "$ref": "#/$defs/AgentSequenceAsset"
          },
          {
            "$ref": "#/$defs/AgentAssetRefEntry"
          }
        ]
      }
    },
    "bindings": {
      "$ref": "#/$defs/Type_e97ffeacd19b"
    }
  },
  "additionalProperties": false,
  "required": ["bindings", "entries", "version"],
  "$defs": {
    "AgentAssetProvenance": {
      "type": "object",
      "properties": {
        "sourcePath": {
          "type": "string"
        },
        "assetRef": {
          "type": "string"
        },
        "sourceRef": {
          "type": "string"
        },
        "originalSha256": {
          "type": "string"
        },
        "originalMimeType": {
          "type": "string"
        },
        "conversion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AgentAssetRefEntry": {
      "description": "An asset whose bytes are held outside the project JSON. `data` is deliberately\nabsent rather than optional: that makes every existing `.data` reader a compile\nerror, instead of a value that type-checks and fails at render time.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["image", "sequence"],
          "type": "string"
        },
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "mimeType": {
          "$ref": "#/$defs/AgentImageMimeType"
        },
        "encoding": {
          "type": "string",
          "const": "ref"
        },
        "ref": {
          "$ref": "#/$defs/MediaRef"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/MediaRef"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1
              },
              "encoding": {
                "const": "ref"
              }
            },
            "required": ["ref", "sha256", "byteLength"],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 240
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "provenance": {
          "$ref": "#/$defs/AgentAssetProvenance"
        }
      },
      "additionalProperties": false,
      "required": [
        "byteLength",
        "encoding",
        "height",
        "id",
        "kind",
        "mimeType",
        "sha256",
        "sourceName",
        "width"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": ["ref"],
            "not": {
              "anyOf": [
                {
                  "required": ["frames"]
                },
                {
                  "required": ["fps"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "required": ["frames", "fps"],
            "properties": {
              "mimeType": {
                "const": "image/png"
              }
            },
            "not": {
              "required": ["ref"]
            }
          }
        }
      ]
    },
    "AgentImageAsset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "image"
        },
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "mimeType": {
          "$ref": "#/$defs/AgentImageMimeType"
        },
        "encoding": {
          "type": "string",
          "const": "base64"
        },
        "data": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "provenance": {
          "$ref": "#/$defs/AgentAssetProvenance"
        }
      },
      "additionalProperties": false,
      "required": [
        "byteLength",
        "data",
        "encoding",
        "height",
        "id",
        "kind",
        "mimeType",
        "sha256",
        "sourceName",
        "width"
      ]
    },
    "AgentImageBinding": {
      "type": "object",
      "properties": {
        "slotId": {
          "type": "string"
        },
        "assetId": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentImageRole"
        },
        "fit": {
          "$ref": "#/$defs/RuntimeImageFit"
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "$ref": "#/$defs/RuntimeImageBlendMode"
        },
        "inset": {
          "type": "number"
        },
        "transform": {
          "$ref": "#/$defs/AgentImageTransform"
        },
        "playback": {
          "description": "Present only for sequence slots; image slots reject it.",
          "$ref": "#/$defs/AgentSequencePlayback"
        }
      },
      "additionalProperties": false,
      "required": ["assetId", "blendMode", "fit", "inset", "opacity", "role", "slotId"]
    },
    "AgentImageMimeType": {
      "enum": ["image/jpeg", "image/png"],
      "type": "string"
    },
    "AgentImageRole": {
      "enum": [
        "background-image",
        "board-atlas-image",
        "effect-sequence",
        "particle-sprite",
        "texture-map",
        "tile-face-image",
        "tile-material-image",
        "ui-image"
      ],
      "type": "string"
    },
    "AgentImageTransform": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "anchorX": {
          "type": "number"
        },
        "anchorY": {
          "type": "number"
        },
        "rotationDeg": {
          "type": "number"
        },
        "clipRadius": {
          "type": "number"
        },
        "layer": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "AgentSequenceAsset": {
      "description": "Ordered transparent PNG frames stored as one asset, hashed frame by frame.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "sequence"
        },
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "mimeType": {
          "type": "string",
          "const": "image/png"
        },
        "encoding": {
          "type": "string",
          "const": "base64"
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentSequenceFrame"
          },
          "minItems": 2,
          "maxItems": 240
        },
        "provenance": {
          "$ref": "#/$defs/AgentAssetProvenance"
        }
      },
      "additionalProperties": false,
      "required": [
        "byteLength",
        "encoding",
        "fps",
        "frames",
        "height",
        "id",
        "kind",
        "mimeType",
        "sha256",
        "sourceName",
        "width"
      ]
    },
    "AgentSequenceFrame": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": ["byteLength", "data", "sha256"]
    },
    "AgentSequencePlayback": {
      "description": "Deterministic sequence playback. Elapsed frames come from the bound event's own\npresentation window, so a seek renders the same sprite frame as sequential playback.",
      "type": "object",
      "properties": {
        "startOffsetFrames": {
          "type": "number"
        },
        "durationFrames": {
          "type": ["null", "number"]
        },
        "speed": {
          "type": "number"
        },
        "loop": {
          "type": "boolean"
        },
        "holdLastFrame": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": ["durationFrames", "holdLastFrame", "loop", "speed", "startOffsetFrames"]
    },
    "MediaRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(\\./(?!.*\\.\\.).*|cas:sha256-[a-fA-F0-9]{64}|lib://.+@sha256-[a-fA-F0-9]{64})$",
      "description": "Project-relative attachment, CAS or hash-pinned library reference. Bytes and hashes are checked by the resolver."
    },
    "RuntimeImageBlendMode": {
      "enum": ["multiply", "overlay", "screen", "soft-light", "source-over"],
      "type": "string"
    },
    "RuntimeImageFit": {
      "enum": ["contain", "cover", "stretch"],
      "type": "string"
    },
    "Type_e97ffeacd19b": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AgentImageBinding"
      }
    }
  }
}
