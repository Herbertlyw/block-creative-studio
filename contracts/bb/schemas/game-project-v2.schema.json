{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://block-creative.local/schema/game-project-v2.json",
  "title": "Studio project V2 common envelope",
  "$comment": "Generated by npm run schemas:generate from persisted TS types and live game contracts. Do not edit this file directly.",
  "description": "Structural validation only. Run the owning game validation, replay and asset resolver for cross-field identity, geometry, hashes, resource budgets and rendering readiness.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "bcs-studio-project"
    },
    "version": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "game": {
      "$ref": "#/$defs/GameProjectEnvelope"
    },
    "production": {
      "$ref": "#/$defs/StudioProjectProductionV2"
    },
    "takes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GameReplayEnvelope"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "direction": {
      "$ref": "#/$defs/StudioProjectDirectionV2"
    }
  },
  "additionalProperties": false,
  "required": ["format", "game", "id", "name", "production", "takes", "version"],
  "$defs": {
    "AssetRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "contentHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false,
      "required": ["id", "kind", "version"]
    },
    "GameActionEnvelope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "actor": {
          "enum": ["agent", "human"],
          "type": "string"
        },
        "schemaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "action": {}
      },
      "additionalProperties": false,
      "required": ["id", "actor", "schemaId", "action"]
    },
    "GameProjectEnvelope": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "const": "bcs.game-project"
        },
        "contractVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "game": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "moduleVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "rulesetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "rulesetVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "additionalProperties": false,
          "required": ["id", "moduleVersion", "rulesetId", "rulesetVersion"]
        },
        "config": {
          "type": "object",
          "properties": {
            "schemaId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "data": {}
          },
          "additionalProperties": false,
          "required": ["data", "schemaId"]
        },
        "initialState": {
          "type": "object",
          "properties": {
            "schemaId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "data": {},
            "stateHash": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "additionalProperties": false,
          "required": ["data", "schemaId", "stateHash"]
        }
      },
      "additionalProperties": false,
      "required": ["config", "contract", "contractVersion", "game", "initialState"]
    },
    "GameReplayEnvelope": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "const": "bcs.game-replay"
        },
        "contractVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "moduleVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "takeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "initialStateHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GameActionEnvelope"
          },
          "minItems": 0,
          "maxItems": 500
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionRecord"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "additionalProperties": false,
      "required": [
        "actions",
        "contract",
        "contractVersion",
        "gameId",
        "initialStateHash",
        "interactions",
        "moduleVersion",
        "seed",
        "takeId"
      ]
    },
    "InteractionRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "modality": {
          "enum": ["pointer", "system", "tap", "touch"],
          "type": "string"
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "endFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionSample"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "committedActionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "metadata": {
          "$ref": "#/$defs/Type_f9003a49fad4"
        }
      },
      "additionalProperties": false,
      "required": ["endFrame", "id", "modality", "startFrame"]
    },
    "InteractionSample": {
      "type": "object",
      "properties": {
        "frameOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "required": ["frameOffset", "x", "y"]
    },
    "OutputSpec": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4096,
          "multipleOf": 2
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "quality": {
          "enum": ["cinematic", "preview", "standard"],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["fps", "height", "quality", "width"]
    },
    "ProductionActionTiming": {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "sourceStartFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceEndFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "holdBeforeFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holdAfterFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": ["actionId", "sourceEndFrame", "sourceStartFrame"]
    },
    "ProductionAudio": {
      "type": "object",
      "properties": {
        "selectedPackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "masterGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "mastering": {
          "description": "Opt-in reference audio path; the default soft limiter remains unchanged.",
          "enum": ["preserve-level", "soft-limit"],
          "type": "string"
        },
        "sfxEnabled": {
          "type": "boolean"
        },
        "sfxGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "bgm": {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "enabled": {
              "type": "boolean"
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "loop": {
              "type": "boolean"
            },
            "startSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 3600
            },
            "sourceOffsetSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 3600
            },
            "fadeInSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "fadeOutSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            }
          },
          "additionalProperties": false,
          "required": ["assetId"]
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductionAudioCue"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "assets": {
          "$ref": "#/$defs/Type_7c015043d0c8"
        }
      },
      "additionalProperties": false
    },
    "ProductionAudioAsset": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "kind": {
              "type": "string",
              "const": "audio"
            },
            "mimeType": {
              "enum": ["audio/wav", "audio/x-wav"],
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "provenance": {
              "type": "object",
              "properties": {
                "sourcePath": {
                  "type": "string"
                },
                "assetRef": {
                  "type": "string"
                },
                "sourceRef": {
                  "type": "string"
                },
                "originalSha256": {
                  "type": "string"
                },
                "originalMimeType": {
                  "type": "string"
                },
                "conversion": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "encoding": {
              "type": "string",
              "const": "base64"
            },
            "data": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64000000,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          },
          "required": ["data", "encoding", "id", "kind", "mimeType", "sha256"]
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "kind": {
              "type": "string",
              "const": "audio"
            },
            "mimeType": {
              "enum": ["audio/wav", "audio/x-wav"],
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "provenance": {
              "type": "object",
              "properties": {
                "sourcePath": {
                  "type": "string"
                },
                "assetRef": {
                  "type": "string"
                },
                "sourceRef": {
                  "type": "string"
                },
                "originalSha256": {
                  "type": "string"
                },
                "originalMimeType": {
                  "type": "string"
                },
                "conversion": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "encoding": {
              "type": "string",
              "const": "ref"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": ["encoding", "id", "kind", "mimeType", "ref", "sha256"]
        }
      ]
    },
    "ProductionAudioCue": {
      "type": "object",
      "properties": {
        "eventType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "offsetSeconds": {
          "type": "number",
          "minimum": -2,
          "maximum": 10
        }
      },
      "additionalProperties": false,
      "required": ["assetId", "eventType"]
    },
    "ProductionCamera": {
      "type": "object",
      "properties": {
        "renderer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "zoom": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "panX": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "panY": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "microX": {
          "type": "number",
          "minimum": -240,
          "maximum": 240
        },
        "microY": {
          "type": "number",
          "minimum": -240,
          "maximum": 240
        },
        "shakeIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false,
      "required": ["renderer"]
    },
    "ProductionClip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "takeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "source": {
          "type": "object",
          "properties": {
            "takeHash": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "frameSourceHash": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": ["takeHash", "frameSourceHash"],
          "additionalProperties": false
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crop": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": ["endFrame", "id", "source", "startFrame", "takeId"]
    },
    "ProductionDirectionV1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "presentation": {
          "type": "object",
          "properties": {
            "sourceFrameSourceHash": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "actionTimings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProductionActionTiming"
              },
              "minItems": 0,
              "maxItems": 500
            }
          },
          "additionalProperties": false,
          "required": ["actionTimings", "sourceFrameSourceHash"]
        },
        "camera": {
          "$ref": "#/$defs/ProductionCamera"
        },
        "effects": {
          "$ref": "#/$defs/ProductionEffects"
        },
        "audio": {
          "$ref": "#/$defs/ProductionAudio"
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductionClip"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "selectedClipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      },
      "additionalProperties": false,
      "required": ["version"]
    },
    "ProductionEffects": {
      "type": "object",
      "properties": {
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "exposure": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "feedbackText": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "eventType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "durationFrames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["text", "eventType", "durationFrames"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "StudioProjectDirectionV2": {
      "type": "object",
      "properties": {
        "rhythm": {
          "type": "object"
        },
        "style": {},
        "production": {
          "$ref": "#/$defs/ProductionDirectionV1"
        }
      },
      "additionalProperties": false,
      "required": ["rhythm"]
    },
    "StudioProjectProductionV2": {
      "type": "object",
      "properties": {
        "layoutProfileRef": {
          "$ref": "#/$defs/AssetRef"
        },
        "cameraProfileRef": {
          "$ref": "#/$defs/AssetRef"
        },
        "lookPackRef": {
          "$ref": "#/$defs/AssetRef"
        },
        "output": {
          "$ref": "#/$defs/OutputSpec"
        }
      },
      "additionalProperties": false,
      "required": ["cameraProfileRef", "layoutProfileRef", "lookPackRef", "output"]
    },
    "Type_7c015043d0c8": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProductionAudioAsset"
      }
    },
    "Type_f9003a49fad4": {
      "type": "object",
      "additionalProperties": {}
    }
  }
}
