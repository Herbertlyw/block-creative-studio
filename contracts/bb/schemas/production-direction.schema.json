{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://block-creative.local/schema/production-direction-v1.json",
  "title": "Production direction, audio and clips",
  "$comment": "Generated by npm run schemas:generate from persisted TS types and live game contracts. Do not edit this file directly.",
  "description": "Structural validation only. Run the owning game validation, replay and asset resolver for cross-field identity, geometry, hashes, resource budgets and rendering readiness.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "sourceFrameSourceHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "actionTimings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductionActionTiming"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "additionalProperties": false,
      "required": ["actionTimings", "sourceFrameSourceHash"]
    },
    "camera": {
      "$ref": "#/$defs/ProductionCamera"
    },
    "effects": {
      "$ref": "#/$defs/ProductionEffects"
    },
    "audio": {
      "$ref": "#/$defs/ProductionAudio"
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProductionClip"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "selectedClipId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    }
  },
  "additionalProperties": false,
  "required": ["version"],
  "$defs": {
    "ProductionActionTiming": {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "sourceStartFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceEndFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "holdBeforeFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holdAfterFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": ["actionId", "sourceEndFrame", "sourceStartFrame"]
    },
    "ProductionAudio": {
      "type": "object",
      "properties": {
        "selectedPackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "masterGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "mastering": {
          "description": "Opt-in reference audio path; the default soft limiter remains unchanged.",
          "enum": ["preserve-level", "soft-limit"],
          "type": "string"
        },
        "sfxEnabled": {
          "type": "boolean"
        },
        "sfxGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "bgm": {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "enabled": {
              "type": "boolean"
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "loop": {
              "type": "boolean"
            },
            "startSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 3600
            },
            "sourceOffsetSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 3600
            },
            "fadeInSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "fadeOutSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            }
          },
          "additionalProperties": false,
          "required": ["assetId"]
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductionAudioCue"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "assets": {
          "$ref": "#/$defs/Type_7c015043d0c8"
        },
        "voices": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ProductionVoiceCue"
          }
        },
        "ducking": {
          "$ref": "#/$defs/ProductionAudioDucking"
        }
      },
      "additionalProperties": false
    },
    "ProductionAudioAsset": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "kind": {
              "type": "string",
              "const": "audio"
            },
            "mimeType": {
              "enum": ["audio/wav", "audio/x-wav"],
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "provenance": {
              "type": "object",
              "properties": {
                "sourcePath": {
                  "type": "string"
                },
                "assetRef": {
                  "type": "string"
                },
                "sourceRef": {
                  "type": "string"
                },
                "originalSha256": {
                  "type": "string"
                },
                "originalMimeType": {
                  "type": "string"
                },
                "conversion": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "encoding": {
              "type": "string",
              "const": "base64"
            },
            "data": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64000000,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          },
          "required": ["data", "encoding", "id", "kind", "mimeType", "sha256"]
        },
        {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "kind": {
              "type": "string",
              "const": "audio"
            },
            "mimeType": {
              "enum": ["audio/wav", "audio/x-wav"],
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "provenance": {
              "type": "object",
              "properties": {
                "sourcePath": {
                  "type": "string"
                },
                "assetRef": {
                  "type": "string"
                },
                "sourceRef": {
                  "type": "string"
                },
                "originalSha256": {
                  "type": "string"
                },
                "originalMimeType": {
                  "type": "string"
                },
                "conversion": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "encoding": {
              "type": "string",
              "const": "ref"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": ["encoding", "id", "kind", "mimeType", "ref", "sha256"]
        }
      ]
    },
    "ProductionAudioCue": {
      "type": "object",
      "properties": {
        "eventType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "offsetSeconds": {
          "type": "number",
          "minimum": -2,
          "maximum": 10
        }
      },
      "additionalProperties": false,
      "required": ["assetId", "eventType"]
    },
    "ProductionCamera": {
      "type": "object",
      "properties": {
        "renderer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "zoom": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "panX": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "panY": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "microX": {
          "type": "number",
          "minimum": -240,
          "maximum": 240
        },
        "microY": {
          "type": "number",
          "minimum": -240,
          "maximum": 240
        },
        "shakeIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false,
      "required": ["renderer"]
    },
    "ProductionClip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "takeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "source": {
          "type": "object",
          "properties": {
            "takeHash": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "frameSourceHash": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": ["takeHash", "frameSourceHash"],
          "additionalProperties": false
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crop": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": ["endFrame", "id", "source", "startFrame", "takeId"]
    },
    "ProductionEffects": {
      "type": "object",
      "properties": {
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "exposure": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "feedbackText": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "eventType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "durationFrames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["text", "eventType", "durationFrames"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Type_7c015043d0c8": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProductionAudioAsset"
      }
    },
    "ProductionVoiceCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "takeId", "assetId", "startSeconds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "takeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "startSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "enabled": {
          "type": "boolean"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "sourceOffsetSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "fadeInSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "fadeOutSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "ProductionAudioDucking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "bgmGain",
        "sfxGain",
        "eventTypes",
        "attackSeconds",
        "releaseSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bgmGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sfxGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eventTypes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        },
        "attackSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "releaseSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    }
  }
}
