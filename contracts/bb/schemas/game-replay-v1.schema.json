{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://block-creative.local/schema/game-replay-v1.json",
  "title": "Game replay envelope",
  "$comment": "Generated by npm run schemas:generate from persisted TS types and live game contracts. Do not edit this file directly.",
  "description": "Structural validation only. Run the owning game validation, replay and asset resolver for cross-field identity, geometry, hashes, resource budgets and rendering readiness.",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "bcs.game-replay"
    },
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "gameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "moduleVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "takeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "initialStateHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GameActionEnvelope"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InteractionRecord"
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "additionalProperties": false,
  "required": [
    "actions",
    "contract",
    "contractVersion",
    "gameId",
    "initialStateHash",
    "interactions",
    "moduleVersion",
    "seed",
    "takeId"
  ],
  "$defs": {
    "GameActionEnvelope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "actor": {
          "enum": ["agent", "human"],
          "type": "string"
        },
        "schemaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "action": {}
      },
      "additionalProperties": false,
      "required": ["id", "actor", "schemaId", "action"]
    },
    "InteractionRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "modality": {
          "enum": ["pointer", "system", "tap", "touch"],
          "type": "string"
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "endFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InteractionSample"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "committedActionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "metadata": {
          "$ref": "#/$defs/Type_f9003a49fad4"
        }
      },
      "additionalProperties": false,
      "required": ["endFrame", "id", "modality", "startFrame"]
    },
    "InteractionSample": {
      "type": "object",
      "properties": {
        "frameOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "required": ["frameOffset", "x", "y"]
    },
    "Type_f9003a49fad4": {
      "type": "object",
      "additionalProperties": {}
    }
  }
}
